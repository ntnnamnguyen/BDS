# NestJS API URL used only by the Next.js server runtime.
API_BASE_URL=http://localhost:3001/api/v1

# Shared only between the Next.js server and NestJS admin endpoints.
BACKEND_ADMIN_API_KEY=replace-with-shared-random-key-at-least-32-characters

# Transitional HTTP Basic Auth for /admin. Use at least 16 password characters
# in production, over HTTPS. Replace with identity-based auth/RBAC later.
ADMIN_UI_USERNAME=admin
ADMIN_UI_PASSWORD=replace-with-another-long-random-secret

# Master switch for development mock UI. Development defaults to true when this
# variable is omitted; production always forces it off.
NEXT_PUBLIC_UI_ENABLE_MOCKS=true

# Server-side project/lead mock. It follows the master switch and defaults to
# true in development; set false to keep only the visual scenario selectors.
API_ENABLE_MOCK_FALLBACK=true

# Form result while mock fallback is enabled: success | conflict | error.
API_MOCK_LEAD_RESULT=success

# Mapbox public browser token.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.eyJ1IjoibmFtbmd1eWVudGhlIiwiYSI6ImNtb2QyYzd5aDA0OXUycXB6dDJlbHI1MDIifQ.bQSp7KHl97Ce5gtXHLSCDQ
