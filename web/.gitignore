# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Additional build output, logs and caches
/dist/
logs/
*.log
.nyc_output/
.pnpm-store/
.npm/
.cache/
.turbo/
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Local credentials, deployment and agent settings
.aws/
.ssh/
*.key
*.p12
*.pfx
.netlify/
.codex/
.agents/

# Temporary files, local backups and databases
.temp/
.tmp/
tmp/
backups/
*.bak
*.db
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm
*.pid
*.pid.lock

# OS and editor files
._*
Thumbs.db
Desktop.ini
.idea/
*.swp
*.swo
*~
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
